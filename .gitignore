# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
yarn.lock
package-lock.json

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# Local Netlify folder
.netlify
.history

# pnpm 11 writes local build approvals here; must never reach the host.
# Its presence makes Vercel treat this repo as a monorepo and fails the build.
pnpm-workspace.yaml

# Internal planning docs must never sit under public/ — Next.js serves that
# directory verbatim, so anything committed there is published at a URL.
# The work plan now lives at the repo root, alongside PROJECT.md, where it is
# not served. This guard stays so one cannot be added back under public/.
public/**/*.md

# ---------------------------------------------------------------------------
# Recruitment system (RECRUITMENT-SPEC.md).
#
# This subsystem is the only part of the site that stores personal data:
# job applications, uploaded certificates and CVs, and references. None of it
# may ever reach the repository. Added before the first row was written, as
# the spec requires, and checked in Phase 7 pass 2.
# ---------------------------------------------------------------------------

# Any local database file, whatever driver is in use.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/.pgdata/
/data/recruitment/

# Uploaded files: certificates, CVs. Stored in object storage in production;
# this covers any local staging directory used while developing.
/uploads/
/private-uploads/
/tmp-uploads/

# Generated application and reference PDFs.
/generated-pdfs/
*.application.pdf
*.reference.pdf

# Environment files. `.env` is the dangerous one: Next.js auto-loads it into
# the server environment, and it would carry the database connection string,
# the SMTP password and the status-page password. `.gitignore` previously
# covered only .env.local and the .env.*.local variants, not a bare `.env`.
.env
.env.*
!.env.example
