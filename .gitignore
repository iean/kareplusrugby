# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
yarn.lock
package-lock.json

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
# .env itself, not just the .local variants. CLAUDE.md rule 6 says a .env is
# never committed because Next.js auto-loads it into the server environment -
# but that rule relied on .git/info/exclude, which is now empty, so `git add
# .env` would have worked. It is listed here instead, where it cannot be lost.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# Local Netlify folder
.netlify
.history

# pnpm 11 writes local build approvals here; must never reach the host.
# Its presence makes Vercel treat this repo as a monorepo and fails the build.
pnpm-workspace.yaml

# Internal planning docs must never sit under public/ — Next.js serves that
# directory verbatim, so anything committed there is published at a URL.
# The work plan now lives at the repo root, alongside PROJECT.md, where it is
# not served. This guard stays so one cannot be added back under public/.
public/**/*.md
